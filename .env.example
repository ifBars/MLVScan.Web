VITE_PUBLIC_API_BASE_URL=http://localhost:8787
VITE_PUBLIC_SITE_URL=http://localhost:5173


# Optional: no events without explicit browser consent and a configured public project token.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_REGION=us
VITE_TELEMETRY_ENVIRONMENT=development

# Seasonal site treatment: auto = October 31 (visitor local date); off = disabled; on = forced.
# Development/staging preview: append ?halloween=preview (off still takes precedence).
VITE_HALLOWEEN_MODE=auto
